{
  "name": "animgraph-editor",
  "version": "0.5.0",
  "description": "Desktop/Web tool for editing Cyberpunk 2077 animgraphs",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "start": "tsx server/index.ts",
    "type-check": "tsc --noEmit",
    "gen:pin-endpoints": "tsx scripts/gen-pin-endpoints.ts",
    "gen:pin-endpoints:check": "tsx scripts/gen-pin-endpoints.ts --check",
    "electron:compile": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --packages=external --external:electron --outdir=dist-electron --format=cjs --out-extension:.js=.js",
    "gen:app-icon": "node scripts/gen-app-icon.mjs",
    "electron:clean": "node scripts/electron-clean.mjs",
    "electron:build": "npm run electron:clean && npm run gen:app-icon && npm run build && npm run electron:compile && electron-builder --win --dir",
    "electron": "npm run electron:compile && electron .",
    "dev:electron": "npm run electron:compile && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5001 && electron .\""
  },
  "build": {
    "appId": "com.tordalor.animgrapheditor",
    "productName": "Animgraph Editor",
    "copyright": "Copyright © 2026 TorDalor",
    "directories": {
      "output": "build",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "buildResources/icon.png",
      "buildResources/icon.ico",
      "package.json",
      "!**/node_modules/**"
    ],
    "electronLanguages": ["en-US"],
    "asar": true,
    "win": {
      "icon": "buildResources/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lucide/vue": "^1.37.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "konva": "^10.0.2",
    "lucide-vue-next": "^0.545.0",
    "pixi.js": "^8.19.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.3.4",
    "webcola": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.4.0",
    "@vue/typescript-plugin": "^3.0.6",
    "concurrently": "^9.2.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "express": "^4.18.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.12",
    "typescript": "^5.0.2",
    "vite": "^6.4.3",
    "vue-tsc": "^3.0.6",
    "wait-on": "^8.0.4"
  },
  "keywords": [
    "cyberpunk2077",
    "animgraph",
    "editor",
    "vue",
    "d3"
  ],
  "author": "TorDalor",
  "license": "GPL-3.0"
}
